local ICO = {
    on = "+", off = "x", gear = "*", info = "i", warn = "!",
    success = "+", error = "x", save = "v", load = "^",
    accent = "*", boot = ">",
}

local notifCount = 0
local NOTIF_STAGGER = 0.05

local function icoFor(text)
    local s = string.lower(text)
    if s:find("enabled") then return ICO.on end
    if s:find("disabled") then return ICO.off end
    if s:find("loaded") then return ICO.load end
    if s:find("saved") or s:find("created") then return ICO.save end
    if s:find("accent") then return ICO.accent end
    if s:find("starting") or s:find("spent hub") then return ICO.boot end
    if s:find("fail") or s:find("error") then return ICO.error end
    return ICO.info
end

