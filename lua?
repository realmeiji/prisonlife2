    local t = Instance.new("Frame")
    t.GroupTransparency = 0
    t:Destroy()
end)

local function playOpen()
    if openState == "opening" or openState == "open" then return end
    openState = "opening"
    cancelAll(closeTweens); cancelAll(openTweens)

    main.Visible = true
    shadow.Visible = true
    bgBlur.Visible = true
    main.Size = UDim2.new(0, 740 * 0.90, 0, 440 * 0.90)
    main.Position = baseMainPos + UDim2.new(0, 18, 0, 25)
    main.BackgroundTransparency = 1
    if hasGroup then main.GroupTransparency = 1 end
    mainGlow.Transparency = 1
    mainStroke.Transparency = 1
    shadow.Size = UDim2.new(0, 750 * 0.90, 0, 450 * 0.90)
    shadow.Position = main.Position + UDim2.new(0, -5, 0, -5)
    shadow.BackgroundTransparency = 1
    bgBlur.Size = shadow.Size
    bgBlur.Position = shadow.Position
    bgBlur.BackgroundTransparency = 1
    icon.TextTransparency = 1
    title.TextTransparency = 1

    for _, b in ipairs(tabBtns) do
        b.btn.Position = UDim2.new(-0.35, 0, 0, 0)
    end

    if hasGroup then
        table.insert(openTweens, TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0, BackgroundTransparency = 0.05}))
    else
        table.insert(openTweens, TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.05}))
    end
    table.insert(openTweens, TweenService:Create(mainStroke, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0.5}))
    table.insert(openTweens, TweenService:Create(shadow, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.6}))
    table.insert(openTweens, TweenService:Create(bgBlur, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.55}))

    local midSz = UDim2.new(0, 740 * 1.05, 0, 440 * 1.05)
    local midPos = baseMainPos + UDim2.new(0, -740 * 0.025, 0, -440 * 0.025)
    table.insert(openTweens, TweenService:Create(main, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = midSz, Position = midPos}))

    task.delay(0.28, function()
        if openState ~= "opening" and openState ~= "open" then return end
        TweenService:Create(main, TweenInfo.new(0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = baseMainSz, Position = baseMainPos}):Play()
        TweenService:Create(shadow, TweenInfo.new(0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = baseShadowSz, Position = baseShadowPos}):Play()
        TweenService:Create(bgBlur, TweenInfo.new(0.18, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = baseShadowSz, Position = baseShadowPos}):Play()
    end)

    table.insert(openTweens, TweenService:Create(mainGlow, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Transparency = 0.35}))
    task.delay(0.22, function()
        if openState ~= "opening" and openState ~= "open" then return end
        TweenService:Create(mainGlow, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Transparency = 0.88}):Play()
    end)

    table.insert(openTweens, TweenService:Create(icon, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}))
    table.insert(openTweens, TweenService:Create(title, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}))

    for i, b in ipairs(tabBtns) do
        task.delay(0.15 + (i - 1) * 0.06, function()
            if openState ~= "opening" and openState ~= "open" then return end
            TweenService:Create(b.btn, TweenInfo.new(0.32, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
        end)
    end

    if floatBtn.Visible then
        local t1 = TweenService:Create(floatBtn, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 62, 0, 62), BackgroundTransparency = 0.1})
        local t2 = TweenService:Create(floatBtn, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0), TextTransparency = 1, BackgroundTransparency = 1})
        t1:Play()
        task.delay(0.14, function()
            t2:Play()
            task.wait(0.22)
            pcall(function() floatBtn.Visible = false end)
        end)
    end

    for _, tw in ipairs(openTweens) do tw:Play() end

    task.delay(0.7, function()
        if openState == "opening" then openState = "open" end
    end)
end

local function playClose()
    if openState == "closing" or openState == "closed" then return end
    local wasOpen = openState == "open" or openState == "opening" or openState == "idle"
    openState = "closing"
    cancelAll(openTweens); cancelAll(closeTweens)

    if hasGroup then
        TweenService:Create(main, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0.5}):Play()
    end

    task.delay(0.16, function()
        if openState ~= "closing" then return end
        local sz = UDim2.new(0, 740 * 1.04, 0, 440 * 1.04)
        local pos = main.Position + UDim2.new(0, -740 * 0.02, 0, -440 * 0.02)
        TweenService:Create(main, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Size = sz, Position = pos}):Play()

        task.delay(0.12, function()
            if openState ~= "closing" then return end
            TweenService:Create(main, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 740 * 0.87, 0, 440 * 0.87),
                Position = baseMainPos + UDim2.new(0, 740 * 0.065, 0, 25),
                BackgroundTransparency = 1,
            }):Play()
            if hasGroup then
                TweenService:Create(main, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {GroupTransparency = 1}):Play()
            end
            TweenService:Create(shadow, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 750 * 0.87, 0, 450 * 0.87), BackgroundTransparency = 1
            }):Play()
            TweenService:Create(bgBlur, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 750 * 0.87, 0, 450 * 0.87), BackgroundTransparency = 1
            }):Play()
            TweenService:Create(mainGlow, TweenInfo.new(0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1}):Play()
            TweenService:Create(mainStroke, TweenInfo.new(0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1}):Play()
        end)
    end)

    task.delay(0.3, function()
        if not wasOpen then return end
        floatBtn.Visible = true
        floatBtn.Size = UDim2.new(0, 0, 0, 0)
        floatBtn.TextTransparency = 1
        floatBtn.BackgroundTransparency = 1
        TweenService:Create(floatBtn, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 58, 0, 58), TextTransparency = 0, BackgroundTransparency = 0.15,
        }):Play()
        task.delay(0.2, function()
            TweenService:Create(floatBtn, TweenInfo.new(0.16, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 50, 0, 50)}):Play()
        end)
    end)

    task.delay(0.5, function()
        if openState ~= "closing" then return end
        main.Visible = false
        shadow.Visible = false
        bgBlur.Visible = false
        if hasGroup then main.GroupTransparency = 0 end
        main.BackgroundTransparency = 0.05
        main.Size = baseMainSz
        main.Position = baseMainPos
        shadow.Size = baseShadowSz
        shadow.Position = baseShadowPos
        bgBlur.Size = baseShadowSz
        bgBlur.Position = baseShadowPos
        mainGlow.Transparency = 0.88
        mainStroke.Transparency = 0.5
        openState = "closed"
    end)
end

