local cachedFiles = listfiles(DIR_NAME .. "/" .. tostring(game.PlaceId))

local function listConfigs()
    local out = {}
    for i = 1, #cachedFiles do
        local f = cachedFiles[i]
        if f:sub(-4) == ".lua" then
            local pos = f:find(".lua", 1, true)
            local start = pos
            local ch = f:sub(pos, pos)
            while ch ~= "/" and ch ~= "\\" and ch ~= "" do
                pos = pos - 1
                ch = f:sub(pos, pos)
            end
            if ch == "/" or ch == "\\" then
                table.insert(out, f:sub(pos + 1, start - 1))
            end
        end
    end
    return out
end

